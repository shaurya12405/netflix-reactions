# Copy to .env (never commit .env). Values are baked into the build at build time.
# Step-by-step: docs/SETUP.md
#
# Supabase project URL and the PUBLIC key: "publishable" (sb_publishable_...)
# or the legacy "anon" key. Supabase dashboard -> Project Settings -> API Keys.
# This key is designed to ship in client code; Row Level Security protects
# the data.
# NEVER put the secret / service_role key here.
WXT_SUPABASE_URL=
WXT_SUPABASE_ANON_KEY=
