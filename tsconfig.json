{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": [
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    ".wxt/wxt.d.ts",
    "src",
    "tests/unit",
    "wxt.config.ts",
    "vitest.config.ts"
  ]
}
